# --- Qwen (DashScope) — основной провайдер ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- OpenRouter — резерв (free-модели) ---
OPENROUTER_API_KEY=

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8000
